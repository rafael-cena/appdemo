{
  "endpoint": "/api/time",
  "method": "GET",
  "description": "Retorna a hora atual do servidor no formato YYYY-MM-DD HH:mm:ss",
  "request": {
    "headers": {
      "Accept": "application/json"
    },
    "query": {},
    "body": null
  },
  "response": {
    "success": {
      "status": 200,
      "headers": {
        "Content-Type": "application/json; charset=utf-8",
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Pragma": "no-cache",
        "Expires": "0"
      },
      "body": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time-custom",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "description": "Hora atual do servidor no formato YYYY-MM-DD HH:mm:ss (24h)",
            "example": "2026-11-20 14:30:45"
          }
        },
        "required": ["time"],
        "additionalProperties": false
      }
    },
    "error": {
      "status": 500,
      "headers": {
        "Content-Type": "application/json; charset=utf-8"
      },
      "body": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Mensagem de erro",
            "example": "Falha ao obter hora do servidor"
          }
        },
        "required": ["error"],
        "additionalProperties": false
      }
    }
  },
  "contracts": [
    "FR-002: Atualização automática a cada segundo",
    "FR-003: Hora deve vir do servidor",
    "SC-001: Atualização a cada 1s ±100ms"
  ]
}