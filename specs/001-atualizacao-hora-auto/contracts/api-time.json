{
  "endpoint": "/api/time",
  "method": "GET",
  "description": "Retorna a hora atual do servidor",
  "request": {
    "headers": {
      "Accept": "application/json"
    },
    "query": {},
    "body": null
  },
  "response": {
    "200": {
      "description": "Hora atual obtida com sucesso",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "description": "Hora atual do servidor no formato YYYY-MM-DD HH:mm:ss",
            "example": "2026-11-20 14:30:45"
          },
          "source": {
            "type": "string",
            "enum": ["server"],
            "description": "Origem da hora (sempre 'server')",
            "example": "server"
          }
        },
        "required": ["time", "source"],
        "additionalProperties": false
      },
      "examples": [
        {
          "time": "2026-11-20 14:30:45",
          "source": "server"
        }
      ]
    },
    "500": {
      "description": "Erro interno ao obter hora do servidor",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Internal Server Error"
          }
        }
      }
    }
  },
  "rateLimit": {
    "requests": 60,
    "window": "1 minute",
    "description": "Polling esperado a cada 1 segundo (60 req/min)"
  }
}